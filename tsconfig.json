{
  "compilerOptions": {
    "target": "ES2018",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "paths": {
      "react-horoscope": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "example",
    "*.config.ts"
  ]
}
